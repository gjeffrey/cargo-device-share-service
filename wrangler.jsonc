{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cargo-device-share",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-21",
  "kv_namespaces": [
    {
      "binding": "DEVICE_SHARES"
    },
    {
      "binding": "APP_METADATA"
    }
  ],
  "vars": {
    "APP_NAME": "platform10",
    "APP_URL_SCHEME": "platform10",
    "DOWNLOAD_URL": "",
    "DOWNLOAD_VERSION": "",
    "DOWNLOAD_BUILD_LABEL": "",
    "TUNNEL_BASE_DOMAIN": "share.platform10.uk",
    "CF_ACCOUNT_ID": "",
    "CF_ZONE_ID": ""
  }
}
